diff --git a/pkg/jp3diag/jp3diag.go b/pkg/jp3diag/jp3diag.go
new file mode 100644
index 0000000..9b3ac32
--- /dev/null
+++ b/pkg/jp3diag/jp3diag.go
@@ -0,0 +1,44 @@
+package jp3diag
+
+import (
+	"net"
+	"strings"
+
+	"github.com/daeuniverse/outbound/pkg/logger"
+)
+
+const (
+	targetHostname = "jp3-r.link-t7.com"
+	targetIPv4     = "13.231.27.232"
+	targetPort     = "10033"
+)
+
+// IsTarget limits diagnostic output to the JP3 proxy endpoint. It never
+// resolves names or changes dialing behavior.
+func IsTarget(address string) bool {
+	host, port, err := net.SplitHostPort(address)
+	if err != nil || port != targetPort {
+		return false
+	}
+	host = strings.TrimSuffix(host, ".")
+	return strings.EqualFold(host, targetHostname) || host == targetIPv4
+}
+
+// EnabledForConn propagates the target-only diagnostic guard through transport
+// wrappers without inspecting payload or authentication data.
+func EnabledForConn(conn any) bool {
+	type diagnosticConn interface {
+		JP3Diagnostic() bool
+	}
+	diagnostic, ok := conn.(diagnosticConn)
+	return ok && diagnostic.JP3Diagnostic()
+}
+
+// Printf writes through outbound's existing logger, which dae directs to its
+// normal stderr/procd logging path.
+func Printf(stage, format string, args ...any) {
+	all := make([]any, 0, len(args)+1)
+	all = append(all, stage)
+	all = append(all, args...)
+	logger.Logger.Printf("[JP3DIAG][%s] "+format, all...)
+}
