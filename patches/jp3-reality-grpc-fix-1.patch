@@ -161,0 +164,35 @@ func (x *Reality) UnwrapDialer() netproxy.Dialer {
+// SetNextProtos configures and requires application protocols for the REALITY
+// handshake. The slice is copied so callers cannot mutate live configuration.
+func (x *Reality) SetNextProtos(nextProtos []string) {
+	x.nextProtos = append(x.nextProtos[:0], nextProtos...)
+}
+
+func applyRealityNextProtos(uConn *utls.UConn, nextProtos []string) error {
+	if len(nextProtos) == 0 {
+		return nil
+	}
+	for _, extension := range uConn.Extensions {
+		alpn, ok := extension.(*utls.ALPNExtension)
+		if !ok {
+			continue
+		}
+		alpn.AlpnProtocols = append(alpn.AlpnProtocols[:0], nextProtos...)
+		// Re-apply extensions and marshal Hello.Raw before REALITY authenticates
+		// the complete ClientHello as AEAD associated data.
+		return uConn.BuildHandshakeState()
+	}
+	return errors.New("REALITY: selected fingerprint has no ALPN extension")
+}
+
+func realityNegotiatedNextProto(negotiated string, nextProtos []string) bool {
+	if len(nextProtos) == 0 {
+		return true
+	}
+	for _, nextProto := range nextProtos {
+		if negotiated == nextProto {
+			return true
+		}
+	}
+	return false
+}
