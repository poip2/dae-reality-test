+type realityKeyShareFilterResult struct {
+	curveRemoved bool
+	shareRemoved bool
+}
+
+// applyRealityKeyShareFilter reproduces sing-box v1.12.25's REALITY-specific
+// compatibility behavior. GREASE, X25519, and all unrelated entries retain
+// their original order.
+func applyRealityKeyShareFilter(uConn *utls.UConn) realityKeyShareFilterResult {
+	var result realityKeyShareFilterResult
+	for _, extension := range uConn.Extensions {
+		switch extension := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			filtered := extension.Curves[:0]
+			for _, curveID := range extension.Curves {
+				if curveID == utls.X25519MLKEM768 {
+					result.curveRemoved = true
+					continue
+				}
+				filtered = append(filtered, curveID)
+			}
+			extension.Curves = filtered
+		case *utls.KeyShareExtension:
+			filtered := extension.KeyShares[:0]
+			for _, share := range extension.KeyShares {
+				if share.Group == utls.X25519MLKEM768 {
+					result.shareRemoved = true
+					continue
+				}
+				filtered = append(filtered, share)
+			}
+			extension.KeyShares = filtered
+		}
+	}
+	return result
+}
+
+func applyRealityNextProtos(uConn *utls.UConn, nextProtos []string) error {
+	if len(nextProtos) == 0 {
+		return nil
+	}
+	for _, extension := range uConn.Extensions {
+		if alpn, ok := extension.(*utls.ALPNExtension); ok {
+			alpn.AlpnProtocols = append(alpn.AlpnProtocols[:0], nextProtos...)
+			return nil
