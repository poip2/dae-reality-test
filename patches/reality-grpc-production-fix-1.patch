+func TestRealitySetNextProtosCopiesInput(t *testing.T) {
+	reality := &Reality{}
+	nextProtos := []string{"h2"}
+	reality.SetNextProtos(nextProtos)
+	nextProtos[0] = "mutated"
+	if !reflect.DeepEqual(reality.nextProtos, []string{"h2"}) {
+		t.Fatalf("stored protocols mutated: %#v", reality.nextProtos)
+	}
+}
