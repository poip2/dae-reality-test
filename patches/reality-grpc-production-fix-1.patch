+func TestRealityAdmissionAcceptsVerifiedConnectionWithEmptyALPN(t *testing.T) {
+	if !realityAdmissionAccepted(true, "") {
+		t.Fatal("verified REALITY connection rejected because ALPN is empty")
+	}
+	if realityAdmissionAccepted(false, "h2") {
+		t.Fatal("unverified REALITY connection accepted")
+	}
+}
