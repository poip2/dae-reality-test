+func TestRealityChromeClientHelloFiltersHybridAndKeepsX25519(t *testing.T) {
+	client, server := net.Pipe()
+	defer func() { _ = client.Close() }()
+	defer func() { _ = server.Close() }()
+
+	uConn := utls.UClient(client, &utls.Config{InsecureSkipVerify: true, SessionTicketsDisabled: true}, utls.HelloChrome_Auto)
+	if err := uConn.BuildHandshakeState(); err != nil {
+		t.Fatalf("initial BuildHandshakeState: %v", err)
+	}
+	result := applyRealityKeyShareFilter(uConn)
+	if !result.curveRemoved || !result.shareRemoved {
+		t.Fatalf("expected X25519MLKEM768 curve and share removal: %#v", result)
+	}
+	if err := applyRealityNextProtos(uConn, []string{"h2"}); err != nil {
+		t.Fatalf("applyRealityNextProtos: %v", err)
+	}
+	if err := uConn.BuildHandshakeState(); err != nil {
+		t.Fatalf("final BuildHandshakeState: %v", err)
+	}
+
+	for _, extension := range uConn.Extensions {
+		switch extension := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			for _, curveID := range extension.Curves {
+				if curveID == utls.X25519MLKEM768 {
+					t.Fatal("X25519MLKEM768 curve remains")
+				}
+			}
+		case *utls.KeyShareExtension:
+			for _, share := range extension.KeyShares {
+				if share.Group == utls.X25519MLKEM768 {
+					t.Fatal("X25519MLKEM768 key share remains")
+				}
+			}
+		}
+	}
+	key := realityECDHEKey(&uConn.HandshakeState)
+	if !realityX25519KeyShareMatches(&uConn.HandshakeState, key) {
+		t.Fatal("REALITY authentication key does not match retained X25519 share")
+	}
+	if got := uConn.HandshakeState.Hello.AlpnProtocols; !reflect.DeepEqual(got, []string{"h2"}) {
+		t.Fatalf("unexpected ALPN offer: %#v", got)
+	}
+}
