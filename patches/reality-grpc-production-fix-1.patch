+package vless
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/daeuniverse/outbound/protocol"
+	"github.com/daeuniverse/outbound/protocol/vmess"
+)
+
+func TestClientResponseHeaderPath(t *testing.T) {
+	client, server := net.Pipe()
+	defer func() { _ = client.Close() }()
+	defer func() { _ = server.Close() }()
+
+	conn, err := NewConn(client, Metadata{Metadata: vmess.Metadata{
+		Metadata: protocol.Metadata{
+			IsClient: true,
+			Type:     protocol.MetadataTypeDomain,
+			Hostname: "example.com",
+			Port:     443,
+		},
+		Network: "tcp",
+	}}, make([]byte, 16))
+	if err != nil {
+		t.Fatalf("NewConn: %v", err)
+	}
+	if err = conn.SetDeadline(time.Now().Add(3 * time.Second)); err != nil {
+		t.Fatalf("SetDeadline: %v", err)
+	}
+
+	serverErr := make(chan error, 1)
+	go func() {
+		request := make([]byte, 512)
+		if _, readErr := server.Read(request); readErr != nil {
+			serverErr <- readErr
+			return
+		}
+		_, writeErr := server.Write([]byte{0, 0, 'o', 'k'})
+		serverErr <- writeErr
+	}()
+
+	if _, err = conn.Write([]byte("payload")); err != nil {
+		t.Fatalf("Write: %v", err)
+	}
+	got := make([]byte, 2)
+	if _, err = io.ReadFull(conn, got); err != nil {
+		t.Fatalf("ReadFull: %v", err)
+	}
+	if !bytes.Equal(got, []byte("ok")) {
+		t.Fatalf("unexpected payload: %q", got)
+	}
+	if err = <-serverErr; err != nil {
+		t.Fatalf("server: %v", err)
+	}
+}
