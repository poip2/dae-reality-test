+	uConn := utls.UClient(client, &utls.Config{InsecureSkipVerify: true}, utls.HelloChrome_Auto)
+	if err := uConn.BuildHandshakeState(); err != nil {
+		t.Fatalf("BuildHandshakeState: %v", err)
+	}
+	if err := applyRealityNextProtos(uConn, []string{"h2"}); err != nil {
+		t.Fatalf("applyRealityNextProtos: %v", err)
+	}
+	if got := uConn.HandshakeState.Hello.AlpnProtocols; len(got) != 1 || got[0] != "h2" {
+		t.Fatalf("unexpected ClientHello ALPN: %#v", got)
+	}
+	for _, extension := range uConn.Extensions {
+		if alpn, ok := extension.(*utls.ALPNExtension); ok {
+			if len(alpn.AlpnProtocols) != 1 || alpn.AlpnProtocols[0] != "h2" {
+				t.Fatalf("unexpected ALPN extension: %#v", alpn.AlpnProtocols)
+			}
+			return
+		}
+	}
+	t.Fatal("Chrome fingerprint has no ALPN extension")
