--- /dev/null
+++ b/dialer/v2ray/v2ray_test.go
@@ -0,0 +1,76 @@
+package v2ray
+
+import (
+	"context"
+	"crypto/ecdh"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"testing"
+
+	"github.com/daeuniverse/outbound/dialer"
+	"github.com/daeuniverse/outbound/netproxy"
+	_ "github.com/daeuniverse/outbound/protocol/vless"
+	transportgrpc "github.com/daeuniverse/outbound/transport/grpc"
+	outboundtls "github.com/daeuniverse/outbound/transport/tls"
+)
+
+type constructionTestDialer struct{}
+
+func (constructionTestDialer) DialContext(context.Context, string, string) (netproxy.Conn, error) {
+	return nil, errors.New("unexpected dial")
+}
+
+func randomHex(t *testing.T, size int) string {
+	t.Helper()
+	value := make([]byte, size)
+	if _, err := rand.Read(value); err != nil {
+		t.Fatalf("generate random test value: %v", err)
+	}
+	return hex.EncodeToString(value)
+}
+
+func TestVLESSRealityGRPCConstructionIncludesRealityUnderlay(t *testing.T) {
+	privateKey, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatalf("generate test key: %v", err)
+	}
+	base := constructionTestDialer{}
+	node := &V2Ray{
+		Add:         "127.0.0.1",
+		Port:        "443",
+		ID:          randomHex(t, 16),
+		Net:         "grpc",
+		SNI:         "example.com",
+		Path:        "service",
+		TLS:         "reality",
+		Fingerprint: "chrome",
+		PublicKey:   base64.RawURLEncoding.EncodeToString(privateKey.PublicKey().Bytes()),
+		ShortId:     randomHex(t, 8),
+		Protocol:    "vless",
+	}
+
+	result, _, err := node.Dialer(&dialer.ExtraOption{}, base)
+	if err != nil {
+		t.Fatalf("construct dialer: %v", err)
+	}
+	vlessLayer, ok := result.(netproxy.DialerUnwrapper)
+	if !ok {
+		t.Fatalf("outer dialer does not expose underlay: %T", result)
+	}
+	grpcLayer, ok := vlessLayer.UnwrapDialer().(*transportgrpc.Dialer)
+	if !ok {
+		t.Fatalf("VLESS underlay is not gRPC: %T", vlessLayer.UnwrapDialer())
+	}
+	if !grpcLayer.Presecured {
+		t.Fatal("REALITY gRPC underlay is not marked pre-secured")
+	}
+	realityLayer, ok := grpcLayer.NextDialer.(*outboundtls.Reality)
+	if !ok {
+		t.Fatalf("gRPC context dialer is not REALITY: %T", grpcLayer.NextDialer)
+	}
+	if realityLayer.UnwrapDialer() != base {
+		t.Fatalf("REALITY underlay changed: %T", realityLayer.UnwrapDialer())
+	}
+}
